 "cues": [
  {
   "id": 0,
   "section": 0,
   "voice": "am_michael",
   "start": 0.1,
   "end": 5.726,
   "text": "He spent ten dollars and sixty-nine cents… and stopped a cyberattack in over a hundred countries."
  },
  {
   "id": 1,
   "section": 1,
   "voice": "am_michael",
   "start": 6.026,
   "end": 12.319,
   "text": "May 2017. WannaCry was locking computers everywhere. Hospitals. Factories. Trains."
  },
  {
   "id": 2,
   "section": 2,
   "voice": "am_michael",
   "start": 12.519,
   "end": 18.515,
   "text": "Inside its code, a twenty-two-year-old found a strange web address nobody owned. So he bought it."
  },
  {
   "id": 3,
   "section": 3,
   "voice": "am_michael",
   "start": 18.715,
   "end": 23.998,
   "text": "Before attacking, the worm checked that address. Now someone answered… and it switched itself off."
  },
  {
   "id": 4,
   "section": 4,
   "voice": "am_michael",
   "start": 24.298,
   "end": 26.97,
   "text": "Three months later… the FBI arrested him."
  },
  {
   "id": 5,
   "section": 5,
   "voice": "am_michael",
   "start": 27.32,
   "end": 29.091,
   "text": "The full story is on my channel."
  }
 ],
