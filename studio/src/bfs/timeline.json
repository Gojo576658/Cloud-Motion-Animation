 "cues": [
  {
   "id": 0,
   "section": 0,
   "voice": "am_michael",
   "start": 0.1,
   "end": 3.578,
   "text": "One extra number crashed eight and a half million computers."
  },
  {
   "id": 1,
   "section": 0,
   "voice": "am_michael",
   "start": 3.878,
   "end": 9.436,
   "text": "The security software expected twenty boxes on a form. The update had twenty-one."
  },
  {
   "id": 2,
   "section": 1,
   "voice": "bm_george",
   "start": 9.686,
   "end": 11.776,
   "text": "Eighteen. Nineteen. Twenty…"
  },
  {
   "id": 3,
   "section": 1,
   "voice": "bm_george",
   "start": 11.926,
   "end": 13.288,
   "text": "Twenty… one?"
  },
  {
   "id": 4,
   "section": 2,
   "voice": "am_michael",
   "start": 13.638,
   "end": 17.471,
   "text": "Crash. Airports, banks, hospitals. Blue screens everywhere."
  },
  {
   "id": 5,
   "section": 2,
   "voice": "am_michael",
   "start": 17.671,
   "end": 23.006,
   "text": "And the fix couldn't be downloaded. Someone had to walk to every single computer… by hand."
  },
  {
   "id": 6,
   "section": 3,
   "voice": "am_michael",
   "start": 23.256,
   "end": 25.085,
   "text": "The whole story is on my channel."
  }
 ],
