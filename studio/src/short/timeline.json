 ],
 "cues": [
  {
   "id": 0,
   "section": 0,
   "start": 0.2,
   "end": 3.623,
   "vStart": 0,
   "vEnd": 3.423,
   "hooks": [],
   "text": "Your TV is off. So why is its microphone still awake?"
  },
  {
   "id": 1,
   "section": 1,
   "start": 3.803,
   "end": 8.303,
   "vStart": 3.603,
   "vEnd": 8.103,
   "hooks": [],
   "text": "Researchers spent seventy thousand dollars testing brand-new LG TVs."
  },
  {
   "id": 2,
   "section": 2,
   "start": 8.453,
   "end": 12.766,
   "vStart": 8.253,
   "vEnd": 12.566,
   "hooks": [],
   "text": "With the screen black, they say it was still saving audio… and uploading it later."
  },
  {
   "id": 3,
   "section": 3,
   "start": 13.146,
   "end": 14.099,
   "vStart": 12.946,
   "vEnd": 13.899,
   "hooks": [],
   "text": "Then it got worse."
  },
  {
   "id": 4,
   "section": 4,
   "start": 14.299,
   "end": 20.041,
   "vStart": 14.099,
   "vEnd": 19.841,
   "hooks": [],
   "text": "It scanned thirty-eight devices on the home network. Phones. Watches. Even a 3D printer."
  },
  {
   "id": 5,
   "section": 5,
   "start": 20.191,
   "end": 23.547,
   "vStart": 19.991,
   "vEnd": 23.347,
   "hooks": [],
   "text": "And it could see your neighbour's Wi-Fi. Why would a TV need that?"
  },
  {
   "id": 6,
   "section": 6,
   "start": 23.847,
   "end": 25.915,
   "vStart": 23.647,
   "vEnd": 25.715,
   "hooks": [],
   "text": "LG says these features are optional."
  },
  {
   "id": 7,
   "section": 7,
   "start": 26.065,
   "end": 27.368,
   "vStart": 25.865,
   "vEnd": 27.168,
   "hooks": [],
   "text": "But optional… isn't off."
  },
  {
   "id": 8,
   "section": 8,
   "start": 27.768,
   "end": 34.654,
   "vStart": 27.568,
   "vEnd": 34.454,
   "hooks": [],
   "text": "And this isn't new. In 2017, the CIA had a tool that made a TV look off… while the mic kept recording."
  },
  {
   "id": 9,
   "section": 9,
   "start": 34.954,
   "end": 39.544,
   "vStart": 34.754,
   "vEnd": 39.344,
   "hooks": [],
   "text": "There are five settings that shut this down. The last one? Almost nobody does it."
  },
  {
   "id": 10,
   "section": 10,
   "start": 39.794,
   "end": 44.841,
   "vStart": 39.594,
   "vEnd": 44.641,
   "hooks": [],
   "text": "The full story is in the video linked below. Watch it before you turn your TV off tonight…"
  }
 ],
