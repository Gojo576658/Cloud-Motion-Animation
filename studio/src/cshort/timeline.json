 "cues": [
  {
   "id": 0,
   "section": 0,
   "voice": "am_michael",
   "start": 0.15,
   "end": 1.864,
   "vStart": 0,
   "vEnd": 1.714,
   "text": "Valorant didn't ban the player."
  },
  {
   "id": 1,
   "section": 0,
   "voice": "am_michael",
   "start": 2.184,
   "end": 3.605,
   "vStart": 2.034,
   "vEnd": 3.455,
   "text": "It banned the CPU."
  },
  {
   "id": 2,
   "section": 1,
   "voice": "am_michael",
   "start": 3.905,
   "end": 6.336,
   "vStart": 3.755,
   "vEnd": 6.186,
   "text": "Its old owner cheated. Like… a lot."
  },
  {
   "id": 3,
   "section": 2,
   "voice": "am_michael",
   "start": 6.636,
   "end": 10.453,
   "vStart": 6.486,
   "vEnd": 10.303,
   "text": "So Riot didn't just ban his account. It banned his hardware."
  },
  {
   "id": 4,
   "section": 2,
   "voice": "am_puck",
   "start": 10.533,
   "end": 11.649,
   "vStart": 10.383,
   "vEnd": 11.499,
   "text": "Wait! What did I do?!"
  },
  {
   "id": 5,
   "section": 3,
   "voice": "am_michael",
   "start": 12.049,
   "end": 15.022,
   "vStart": 11.899,
   "vEnd": 14.872,
   "text": "So he did the most normal thing ever. He sold it."
  },
  {
   "id": 6,
   "section": 4,
   "voice": "am_michael",
   "start": 15.872,
   "end": 19.148,
   "vStart": 15.722,
   "vEnd": 18.998,
   "text": "Meet Leo. Found a great deal. Never cheated once."
  },
  {
   "id": 7,
   "section": 4,
   "voice": "am_michael",
   "start": 19.269,
   "end": 20.894,
   "vStart": 19.119,
   "vEnd": 20.744,
   "text": "He opens Valorant… kicked."
  },
  {
   "id": 8,
   "section": 5,
   "voice": "am_michael",
   "start": 21.444,
   "end": 26.145,
   "vStart": 21.294,
   "vEnd": 25.995,
   "text": "He saved up. He did everything right… and paid for someone else's mistake."
  },
  {
   "id": 9,
   "section": 6,
   "voice": "am_puck",
   "start": 26.595,
   "end": 31.567,
   "vStart": 26.445,
   "vEnd": 31.417,
   "text": "Hey… every like takes one day off my sentence. And subscribe… it gets lonely in here."
  },
  {
   "id": 10,
   "section": 7,
   "voice": "am_michael",
   "start": 31.967,
   "end": 35.476,
   "vStart": 31.817,
   "vEnd": 35.326,
   "text": "How? Your CPU has a tiny vault with a secret key."
  },
  {
   "id": 11,
   "section": 7,
   "voice": "am_michael",
   "start": 35.596,
   "end": 38.595,
   "vStart": 35.446,
   "vEnd": 38.445,
   "text": "New Windows? Same key. New account? Same key."
  },
  {
   "id": 12,
   "section": 8,
   "voice": "am_michael",
   "start": 38.945,
   "end": 42.807,
   "vStart": 38.795,
   "vEnd": 42.657,
   "text": "Good news: Riot says hardware bans last four months, max."
  },
  {
   "id": 13,
   "section": 8,
   "voice": "am_michael",
   "start": 42.907,
   "end": 46.212,
   "vStart": 42.757,
   "vEnd": 46.062,
   "text": "Plot twist? Riot doesn't fully buy Leo's story."
  },
  {
   "id": 14,
   "section": 9,
   "voice": "am_michael",
   "start": 46.612,
   "end": 49.512,
   "vStart": 46.462,
   "vEnd": 49.362,
   "text": "The full story is on my channel. So remember:"
  }
 ],
