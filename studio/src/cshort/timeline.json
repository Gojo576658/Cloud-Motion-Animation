 "cues": [
  {
   "id": 0,
   "section": 0,
   "voice": "am_michael",
   "start": 0.15,
   "end": 1.671,
   "vStart": 0,
   "vEnd": 1.521,
   "text": "Valorant didn't ban the player."
  },
  {
   "id": 1,
   "section": 0,
   "voice": "am_michael",
   "start": 1.991,
   "end": 3.303,
   "vStart": 1.841,
   "vEnd": 3.153,
   "text": "It banned the CPU."
  },
  {
   "id": 2,
   "section": 1,
   "voice": "am_michael",
   "start": 3.523,
   "end": 5.687,
   "vStart": 3.373,
   "vEnd": 5.537,
   "text": "Its old owner cheated. Like… a lot."
  },
  {
   "id": 3,
   "section": 2,
   "voice": "am_michael",
   "start": 5.867,
   "end": 9.396,
   "vStart": 5.717,
   "vEnd": 9.246,
   "text": "So Riot didn't just ban his account. It banned his hardware."
  },
  {
   "id": 4,
   "section": 2,
   "voice": "am_puck",
   "start": 9.476,
   "end": 10.38,
   "vStart": 9.326,
   "vEnd": 10.23,
   "text": "Wait! What did I do?!"
  },
  {
   "id": 5,
   "section": 3,
   "voice": "am_michael",
   "start": 10.68,
   "end": 13.336,
   "vStart": 10.53,
   "vEnd": 13.186,
   "text": "So he did the most normal thing ever. He sold it."
  },
  {
   "id": 6,
   "section": 4,
   "voice": "am_michael",
   "start": 14.186,
   "end": 17.267,
   "vStart": 14.036,
   "vEnd": 17.117,
   "text": "Meet Leo. Found a great deal. Never cheated once."
  },
  {
   "id": 7,
   "section": 4,
   "voice": "am_michael",
   "start": 17.387,
   "end": 18.841,
   "vStart": 17.237,
   "vEnd": 18.691,
   "text": "He opens Valorant… kicked."
  },
  {
   "id": 8,
   "section": 5,
   "voice": "am_michael",
   "start": 19.291,
   "end": 23.659,
   "vStart": 19.141,
   "vEnd": 23.509,
   "text": "He saved up. He did everything right… and paid for someone else's mistake."
  },
  {
   "id": 9,
   "section": 6,
   "voice": "am_puck",
   "start": 24.009,
   "end": 28.058,
   "vStart": 23.859,
   "vEnd": 27.908,
   "text": "Hey… every like takes one day off my sentence. And subscribe… it gets lonely in here."
  },
  {
   "id": 10,
   "section": 7,
   "voice": "am_michael",
   "start": 28.358,
   "end": 31.532,
   "vStart": 28.208,
   "vEnd": 31.382,
   "text": "How? Your CPU has a tiny vault with a secret key."
  },
  {
   "id": 11,
   "section": 7,
   "voice": "am_michael",
   "start": 31.652,
   "end": 34.323,
   "vStart": 31.502,
   "vEnd": 34.173,
   "text": "New Windows? Same key. New account? Same key."
  },
  {
   "id": 12,
   "section": 8,
   "voice": "am_michael",
   "start": 34.573,
   "end": 38.266,
   "vStart": 34.423,
   "vEnd": 38.116,
   "text": "Good news: Riot says hardware bans last four months, max."
  },
  {
   "id": 13,
   "section": 8,
   "voice": "am_michael",
   "start": 38.366,
   "end": 41.46,
   "vStart": 38.216,
   "vEnd": 41.31,
   "text": "Plot twist? Riot doesn't fully buy Leo's story."
  },
  {
   "id": 14,
   "section": 9,
   "voice": "am_michael",
   "start": 41.76,
   "end": 44.456,
   "vStart": 41.61,
   "vEnd": 44.306,
   "text": "The full story is on my channel. So remember:"
  }
 ],
